# Copy this file to .env and fill in the real values.
# .env is NEVER committed (it is in .gitignore). This file is: it only holds names, no secrets.

# DeepSeek (conversation, interview plan, report). Required.
DEEPSEEK_API_KEY=

# Optional: if not set, the defaults from app/config.py are used.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash   (more powerful and expensive alternative: deepseek-v4-pro)

# ElevenLabs (voice interview). The backend only requests signed URLs for the agent.
# Create a restricted key: "ElevenLabs Agents" = Write (signed URLs need convai_write),
# everything else = No access.
ELEVENLABS_API_KEY=
# ID of the agent created in the ElevenLabs dashboard, with authentication enabled.
ELEVENLABS_AGENT_ID=

# Access codes for the paid endpoints (header X-Access-Code), comma-separated, 16+ chars each.
# One per person, so each can be revoked alone. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(24))"
ACCESS_CODES=

# Shared secret ElevenLabs sends as a Bearer token when it calls our custom LLM endpoint
# (POST /v1/chat/completions). 32+ chars. Store the same value as an ElevenLabs workspace
# secret for the agent's custom LLM. Generate it with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_LLM_SECRET=
# Optional: voice sessions allowed per access code and UTC day (default 3).
# VOICE_SESSIONS_PER_CODE_PER_DAY=3

# Vercel AI Gateway key for Jev (answer scoring, docs/decisions/0001). Not read by the app yet; phase 1 adds it to Settings.
AI_GATEWAY_API_KEY=
